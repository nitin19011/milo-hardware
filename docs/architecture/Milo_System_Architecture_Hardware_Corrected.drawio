        <mxCell id="gControl" value="Demo trigger + capture coordinator&#10;Full fist held 2 s; require mic READY&#10;Local 1 s cue → 3 s capture → 1 s cue" style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fillColor=#eff6ff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="425" width="430" height="125" />
        </mxCell>
        <mxCell id="handPayload" value="hand/clips • JSON&#10;150 × 9: ax, ay, az, gx, gy, gz, thumb, index, middle&#10;IMU: m/s² (gravity included), rad/s&#10;Fingers: 0 NOT_BENT / 1 BENT&#10;No raw flex ADC in the AI input" style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fillColor=#eff6ff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="430" y="740" width="470" height="175" />
        </mxCell>
        <mxCell id="micPayload" value="mic/clips • BINARY MQTT message&#10;MLW1 + JSON length + metadata JSON + WAV&#10;48,000 samples • 96,044-byte complete WAV&#10;Same capture_id and capture_start_ms as glove" style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=21;fillColor=#eff6ff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="430" y="1410" width="470" height="180" />
        </mxCell>
        <mxCell id="syncNote" value="HOW THE TWO ESPs STAY ALIGNED&#10;Glove → broker → mic: mic/capture (prepare / upload / cancel).&#10;Mic → broker → glove: mic/results (ready / sent / failed).&#10;Both clocks synchronize with SNTP; common scheduled start + capture_id.&#10;No direct ESP-to-ESP radio link; synchronization is estimated, not sample-exact.&#10;No gesture or voice AI inference runs on the ESPs in this demo." style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fillColor=#eff6ff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1110" y="1070" width="1135" height="230" />
        </mxCell>
        <mxCell id="feedbackNote" value="AI FEEDBACK RETURN PATH&#10;Ultra96 → MQTT broker / relay → glove: hand/feedback.&#10;1 × 500 ms: voice rejected, gesture accepted.&#10;2 × 500 ms (250 ms gap): voice accepted, gesture rejected.&#10;Capture cues are separate: 1 s before recording and 1 s after." style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fillColor=#fff7ed;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1110" y="1340" width="1135" height="200" />
        </mxCell>
        <mxCell id="scope" value="Topic prefix: milo/v1/demo/  •  Page 2 shows exact capture sequence, readiness and re-arm rules." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=21;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1110" y="1565" width="1135" height="45" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2 - Hardware capture and timing" id="hardware-timing">
    <mxGraphModel dx="1800" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t" value="Milo — Exact hardware flow for the demo" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=38;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="30" width="1700" height="60" />
        </mxCell>
        <mxCell id="st" value="Current demo7 firmware • fist trigger • paired 3-second clips • no local AI trigger yet" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=24;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="100" width="1700" height="45" />
        </mxCell>
        <mxCell id="ready" value="BEFORE A CAPTURE&#10;Both ESPs: Wi-Fi + verified TLS/MQTT + SNTP clock ready.&#10;Glove also requires a compatible live mic.meta heartbeat (expires after 15 s).&#10;Mic must report idle audio buffers ready; retained metadata alone cannot arm the glove." style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fillColor=#eff6ff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="175" width="1700" height="155" />
        </mxCell>
        <mxCell id="prepare" value="t = 0 s • Full fist begins&#10;Glove creates capture_id and schedules start at t = 3 s.&#10;Publish demo.capture_prepare on mic/capture; keep holding fist." style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="375" width="820" height="155" />
        </mxCell>
        <mxCell id="ack" value="Mic arms its local audio task&#10;Reply demo.capture_ready on mic/results.&#10;Must arrive before the 2-second fist deadline." style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="930" y="375" width="820" height="155" />
        </mxCell>
        <mxCell id="prepAck" parent="1" edge="1" source="prepare" target="ack" value="via MQTT" style="edgeStyle=none;html=0;endArrow=open;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=20;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.4838709677419355;exitPerimeter=0;entryX=0.0;entryY=0.4838709677419355;entryPerimeter=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="hold" value="0–2 s&#10;Hold full fist&#10;Mic prepares / acknowledges" style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fillColor=#f1f5f9;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="600" width="450" height="150" />
        </mxCell>
        <mxCell id="cue" value="2–3 s&#10;START BUZZ (1 s)&#10;Act / speak when it stops" style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fillColor=#fff7ed;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="530" y="600" width="360" height="150" />
        </mxCell>
        <mxCell id="record" value="3–6 s&#10;RECORD TOGETHER (3 s)&#10;Gesture + voice; motor OFF" style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fillColor=#dcfce7;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="920" y="600" width="450" height="150" />
        </mxCell>
        <mxCell id="finish" value="6–7 s&#10;END BUZZ (1 s)&#10;Clips held locally" style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fillColor=#fff7ed;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1400" y="600" width="350" height="150" />
        </mxCell>
        <mxCell id="holdcue" parent="1" edge="1" source="hold" target="cue" value="" style="edgeStyle=none;html=0;endArrow=open;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=20;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="cuerecord" parent="1" edge="1" source="cue" target="record" value="" style="edgeStyle=none;html=0;endArrow=open;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=20;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="recordfinish" parent="1" edge="1" source="record" target="finish" value="" style="edgeStyle=none;html=0;endArrow=open;strokeColor=#334155;strokeWidth=2;fontFamily=Arial;fontSize=20;labelBackgroundColor=#ffffff;exitX=1.0;exitY=0.5;exitPerimeter=0;entryX=0.0;entryY=0.5;entryPerimeter=0;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="upload" value="t ≥ 7 s • FINAL BUZZ OFF → UPLOAD&#10;Glove publishes demo.capture_upload on mic/capture, then hand.clip on hand/clips.&#10;Mic publishes one binary MLW1 / WAV message on mic/clips, then demo.capture_sent after broker PUBACK.&#10;Clip arrival order can differ. The shared session + capture_id pair the recordings." style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=24;fillColor=#eff6ff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="805" width="1700" height="170" />
        </mxCell>
        <mxCell id="features" value="GLOVE PAYLOAD&#10;50 Hz × 3 s = 150 rows, each with 9 features:&#10;[ax, ay, az, gx, gy, gz, thumb, index, middle]&#10;Acceleration m/s² including gravity; gyro rad/s.&#10;Three binary finger states, with calibration metadata.&#10;No gesture classification on the glove ESP." style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1025" width="820" height="205" />
        </mxCell>
        <mxCell id="audio" value="MIC PAYLOAD&#10;16 kHz × 3 s = 48,000 mono PCM16 samples.&#10;44-byte WAV header + 96,000 PCM bytes.&#10;MQTT: MLW1 + uint32 big-endian JSON length&#10;+ UTF-8 mic.clip metadata JSON + complete WAV.&#10;No voice classification on the mic ESP." style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fillColor=#ffffff;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="930" y="1025" width="820" height="205" />
        </mxCell>
        <mxCell id="rules" value="RE-ARM / FAILURE RULES&#10;One capture at a time. Next capture waits for the previous transfer to finish.&#10;Relax the full fist for ≥200 ms to re-arm; all three fingers need not straighten.&#10;Release can occur during the action. No mic readiness → no starting buzz.&#10;Hold / readiness / clock / sensor failures cancel the request; do not treat invalid clips as model input." style="rounded=1;arcSize=4;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=23;fillColor=#fff7ed;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1280" width="1700" height="185" />
        </mxCell>
        <mxCell id="limits" value="Timing: same scheduled UTC window, mapped to each ESP’s local timer / DMA timeline.&#10;Each device gates clock uncertainty to ≤50 ms; this is not a promise of sample-accurate physical synchronization." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Arial;fontSize=22;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1500" width="1700" height="70" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>