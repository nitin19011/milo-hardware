+void runStartupMotorTest() {
+  // GPIO drives only the module's IN pin; its onboard MOSFET supplies the motor current.
+  if (STARTUP_MOTOR_TEST) {
+    Serial.println("# Motor test: D2/GPIO25, three short buzzes; sampling starts after it stops.");
+    for (uint8_t pulse=0; pulse<3; ++pulse) {
+      digitalWrite(HAPTIC_PIN, HIGH); delay(150);
+      digitalWrite(HAPTIC_PIN, LOW); delay(150);
+    }
+  }
+  digitalWrite(HAPTIC_PIN, LOW);
+  delay(700); // Let motor vibration settle before calibrating/sampling the IMU.
+  Serial.println("# Motor OFF. No motor activation during calibration or gesture recording.");
+}
